{
  "name": "solframe-studio",
  "productName": "Solframe Studio",
  "private": true,
  "_comment_desktopName": "Read by electron-builder from the package.json root (metadata.desktopName), NOT from the build config \u2014 it is rejected by the schema under build.linux. Electron derives the Linux app_id / WM_CLASS from it, and the installed .desktop filename is matched to it via build.linux.syncDesktopName. Without it the running window can't be linked to its .desktop entry, so the desktop environment shows no app icon.",
  "desktopName": "solframe-studio.desktop",
  "version": "1.1.3",
  "description": "Standalone AI Image Generation and Chat Studio with FLUX, SDXL, llama.cpp",
  "author": "Protik",
  "license": "GPL-3.0-or-later",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "tsc && vite build && node scripts/deploy-ghpages.js",
    "deploy:product": "node scripts/build-product-page.js",
    "build:installer": "node scripts/build-installer.js",
    "build:installer:lightweight": "node scripts/build-installer.js --lightweight-only",
    "electron:dev": "npm run build && electron electron/main.cjs --dev",
    "electron:pack": "npm run build && electron-builder --dir --win --x64",
    "electron:build": "npm run build && electron-builder --win --x64 --publish=never",
    "electron:portable": "npm run build && electron-builder --win portable --x64 --publish=never",
    "electron:build:linux": "npm run build && electron-builder --linux --publish=never",
    "electron:build:mac": "npm run build && electron-builder --mac --publish=never"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.solframe.studio",
    "productName": "Solframe Studio",
    "asar": true,
    "icon": "electron/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "extraResources": [
        {
          "from": "backend/win",
          "to": "backend/win",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Solframe Studio",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "Solframe-Studio-Portable-${version}.exe"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "electron/icon.png",
      "maintainer": "Protik <protik@solframe.local>",
      "executableName": "solframe-studio",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "solframe-studio"
        }
      },
      "synopsis": "Local generative AI image and LLM workstation",
      "extraResources": [
        {
          "from": "backend/linux",
          "to": "backend/linux",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "extraResources": [
        {
          "from": "backend/mac",
          "to": "backend/mac",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "electron/icon.png"
    },
    "directories": {
      "output": "release"
    }
  }
}
